# Warret Supabase
# Copy this file to .env and fill values from Supabase Dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: Gmail / Outlook warranty inbox import.
# Use public OAuth client IDs only. Never place client secrets in Expo.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_ANDROID=
EXPO_PUBLIC_MS_OAUTH_CLIENT_ID=

# AI document extraction keys must be backend-only.
# Put OPENAI_API_KEY or ANTHROPIC_API_KEY in Supabase Edge Function secrets,
# never as EXPO_PUBLIC_* variables.
# Do not put backend-only service role keys in Expo. They are secret and must stay server-side.
